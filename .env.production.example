# ==============================================================================
# AI BUILDS MY WEBSITE — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env on your production server:
#   cp .env.production.example .env
#
# IMPORTANT:
# 1. Generate an application key using: php artisan key:generate
# 2. Never commit your production .env with real credentials to version control.
# ==============================================================================

# Application Configuration
APP_NAME="AI Builds My Website"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-production-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
# Use daily rotation with info level to keep disk usage controlled
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# Database Configuration (MySQL 8.0+ / Managed Cloud RDS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_builds_my_website_prod
DB_USERNAME=ai_website_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Optional: MySQL SSL / TLS Configuration for AWS RDS / Google Cloud SQL
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Session Configuration
# Database session driver ensures multi-server session persistence
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache Configuration
CACHE_STORE=database
# Or Redis in clustered environments:
# CACHE_STORE=redis

# Queue Driver
QUEUE_CONNECTION=database

# File Storage Configuration
# Files are stored on public disk and linked via php artisan storage:link
FILESYSTEM_DISK=public

# Optional: AWS S3 or Cloudflare R2 Cloud Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-production-bucket
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Gemini AI Integration
# Get API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Optional: Public Web Search Provider (Serper / Google Serper API)
SEARCH_PROVIDER=serper
SEARCH_API_KEY=YOUR_SERPER_API_KEY

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@your-production-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Bundling
VITE_APP_NAME="${APP_NAME}"
